{-# NO_IMPLICIT_PRELUDE #-}

{-# BUILTIN THROW throw #-}
throw : Exception e => e -> a

{-# BUILTIN CATCH catch #-}
catch : Exception e => (Unit -> a) -> (e -> a) -> a

{-# BUILTIN EXCEPTION Exception #-}
trait Exception e = {}

impl Exception Int = {}
impl Exception Float = {}
impl Exception Bool = {}
impl Exception Char = {}
impl Exception String = {}
impl Exception Unit = {}
impl Exception a => Exception [a] = {}
impl (Exception a, Exception b) => Exception (a * b) = {}
