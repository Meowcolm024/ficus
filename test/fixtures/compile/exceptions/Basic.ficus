{-# NO_IMPLICIT_PRELUDE #-} use Class.Show (Show, show)
{-# BUILTIN EXCEPTION Failure #-}
trait Show e => Failure e = {}
{-# BUILTIN THROW raise #-}
raise : Failure e => e -> a
{-# BUILTIN CATCH handle #-}
handle : Failure e => (Unit -> a) -> (e -> a) -> a
impl Failure Int = {}

check () = handle (_ -> raise 7) ((value : Int) -> value)

{-# BUILTIN MATCH_ERROR MatchError #-}
type MatchError = MatchError String
{-# BUILTIN MATCH_FAILURE MatchError #-}
