{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "ficus",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_token"
      }
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "pragma"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "character"
        },
        {
          "type": "SYMBOL",
          "name": "float"
        },
        {
          "type": "SYMBOL",
          "name": "integer"
        },
        {
          "type": "SYMBOL",
          "name": "wildcard"
        },
        {
          "type": "SYMBOL",
          "name": "lower_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "upper_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "upper_operator"
        },
        {
          "type": "SYMBOL",
          "name": "value_operator"
        },
        {
          "type": "SYMBOL",
          "name": "arrow"
        },
        {
          "type": "SYMBOL",
          "name": "bind_arrow"
        },
        {
          "type": "SYMBOL",
          "name": "constraint_arrow"
        },
        {
          "type": "SYMBOL",
          "name": "equals"
        },
        {
          "type": "SYMBOL",
          "name": "colon"
        },
        {
          "type": "SYMBOL",
          "name": "dot"
        },
        {
          "type": "STRING",
          "value": "use"
        },
        {
          "type": "STRING",
          "value": "type"
        },
        {
          "type": "STRING",
          "value": "trait"
        },
        {
          "type": "STRING",
          "value": "impl"
        },
        {
          "type": "STRING",
          "value": "with"
        },
        {
          "type": "STRING",
          "value": "if"
        },
        {
          "type": "STRING",
          "value": "where"
        },
        {
          "type": "STRING",
          "value": "do"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "}"
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "--[^\\r\\n]*"
        }
      }
    },
    "block_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "{-"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^-]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "-[^}]"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "-}"
            }
          ]
        }
      }
    },
    "pragma": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "{-#"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^#]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "#[^-]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "#-[^}]"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "#-}"
            }
          ]
        }
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\[\\\\'\"nrt]"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "character": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "'"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^'\\\\\\r\\n]"
              },
              {
                "type": "PATTERN",
                "value": "\\\\[\\\\'\"nrt]"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "'"
          }
        ]
      }
    },
    "float": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\d+\\.\\d+"
      }
    },
    "integer": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\d+"
      }
    },
    "wildcard": {
      "type": "STRING",
      "value": "_"
    },
    "lower_identifier": {
      "type": "PATTERN",
      "value": "\\p{Ll}[\\p{L}\\p{M}\\p{N}_']*"
    },
    "upper_identifier": {
      "type": "PATTERN",
      "value": "\\p{Lu}[\\p{L}\\p{M}\\p{N}_']*"
    },
    "upper_operator": {
      "type": "PATTERN",
      "value": ":[!#$%&*+\\/<=>?@\\\\^|~:\\-]+"
    },
    "value_operator": {
      "type": "PATTERN",
      "value": "[!#$%&*+\\/<=>?@\\\\^|~\\-][!#$%&*+\\/<=>?@\\\\^|~:\\-]*"
    },
    "arrow": {
      "type": "STRING",
      "value": "->"
    },
    "bind_arrow": {
      "type": "STRING",
      "value": "<-"
    },
    "constraint_arrow": {
      "type": "STRING",
      "value": "=>"
    },
    "equals": {
      "type": "STRING",
      "value": "="
    },
    "colon": {
      "type": "STRING",
      "value": ":"
    },
    "dot": {
      "type": "STRING",
      "value": "."
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\s\\uFEFF\\u2060\\u200B]+"
    },
    {
      "type": "SYMBOL",
      "name": "line_comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}