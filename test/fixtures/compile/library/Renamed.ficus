{-# NO_IMPLICIT_PRELUDE #-}
{-# BUILTIN VOID Empty #-}
Empty : Type
{-# BUILTIN ABSURD eliminate #-}
eliminate : Empty -> a
{-# BUILTIN VEC Vector #-}
Vector : Type -> Type
{-# BUILTIN VEC_FROM_LIST pack #-}
pack : [a] -> Vector a
{-# BUILTIN VEC_TO_LIST unpack #-}
unpack : Vector a -> [a]
{-# BUILTIN BYTE Octet #-}
Octet : Type
{-# BUILTIN BYTE_FROM_INT octet #-}
octet : Int -> Octet
{-# BUILTIN HANDLE Stream #-}
Stream : Type
{-# BUILTIN HANDLE_STDIN input #-}
input : Stream
{-# BUILTIN HANDLE_READ readStream #-}
readStream : Stream -> Int -> String
{-# BUILTIN HANDLE_WRITE writeStream #-}
writeStream : Stream -> String -> Unit
