{-# NO_IMPLICIT_PRELUDE #-}
use Ficus.Builtin.Errors (..)
use Class.Show (floatShow) pub

{-# BUILTIN FLOAT_ADD floatAdd #-}
floatAdd : Float -> Float -> Float
{-# BUILTIN FLOAT_SUB floatSub #-}
floatSub : Float -> Float -> Float
{-# BUILTIN FLOAT_MUL floatMul #-}
floatMul : Float -> Float -> Float
{-# BUILTIN FLOAT_DIV floatDiv #-}
floatDiv : Float -> Float -> Float
{-# BUILTIN FLOAT_EQ floatEq #-}
floatEq : Float -> Float -> Bool
{-# BUILTIN FLOAT_LT floatLt #-}
floatLt : Float -> Float -> Bool
{-# BUILTIN FLOAT_TO_INT floatToInt #-}
floatToInt : Float -> Int
