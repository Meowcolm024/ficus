source-repository head
  type: git
  location: https://github.com/Meowcolm024/ficus

library
  exposed-modules:
      Ficus.Syntax.Concrete
      Ficus.Syntax.Concrete.Pretty
      Ficus.Syntax.Parser
      Ficus.Syntax.Parser.Lexer
      Ficus.Syntax.Source
  other-modules:
      Paths_ficus
  autogen-modules:
      Paths_ficus
  hs-source-dirs:
      src
  default-extensions:
      DataKinds
      DerivingVia
      GADTs
      LambdaCase
      MultiWayIf
      NoStarIsType
      OverloadedStrings
      StrictData
      TypeFamilies
      ViewPatterns
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -Wunused-imports -fprint-explicit-foralls -fprint-explicit-kinds -Werror
  build-depends:
      base >=4.7 && <5
    , containers
    , megaparsec
    , mtl
    , pretty
    , text
    , transformers
    , vector
  default-language: GHC2021

executable ficus
  main-is: Main.hs
  other-modules:
      CLI
      Paths_ficus
  autogen-modules:
      Paths_ficus
  hs-source-dirs:
      app
  default-extensions:
      DataKinds
      DerivingVia
      GADTs
      LambdaCase
      MultiWayIf
      NoStarIsType
      OverloadedStrings
      StrictData
      TypeFamilies
      ViewPatterns
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -Wunused-imports -fprint-explicit-foralls -fprint-explicit-kinds -Werror -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , containers
    , ficus
    , haskeline
    , megaparsec
    , mtl
    , optparse-applicative
    , pretty
    , text
    , transformers
    , vector
  default-language: GHC2021

