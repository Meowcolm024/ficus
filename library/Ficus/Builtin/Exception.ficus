{-# NO_IMPLICIT_PRELUDE #-}
use Class.Show (Show, show)

{-# BUILTIN THROW throw #-}
throw : Exception e => e -> a

{-# BUILTIN CATCH catch #-}
catch : Exception e => (Unit -> a) -> (e -> a) -> a

{-# BUILTIN EXCEPTION Exception #-}
trait Show e => Exception e = {}

{-# BUILTIN SOMEEXCEPTION SomeException #-}
type SomeException =
    Err : Type
    err : Err
    showErr : Err -> String
{-# BUILTIN SOMEEXCEPTION_ERR SomeException.Err #-}
{-# BUILTIN SOMEEXCEPTION_VALUE SomeException.err #-}
{-# BUILTIN SOMEEXCEPTION_SHOWERR SomeException.showErr #-}

impl Show SomeException =
    show package = with package
        SomeException with { err = value; showErr = render } -> render value
impl Exception SomeException = {}


impl Exception Int = {}
impl Exception Float = {}
impl Exception Bool = {}
impl Exception Char = {}
impl Exception String = {}
impl Exception Unit = {}
impl Exception a => Exception [a] = {}
impl (Exception a, Exception b) => Exception (a * b) = {}
