{-# NO_IMPLICIT_PRELUDE #-}

use Class.Eq (Eq, (==), (/=)) pub
use Class.Ord (Ord, compare, (<), (<=), (>), (>=), min, max) pub
use Class.Show (Show, show) pub
use Class.Debug (Debug, debug) pub
use Class.Default (Default, default) pub
use Class.Add (Add, (+)) pub
use Class.Sub (Sub, (-)) pub
use Class.Mul (Mul, (*)) pub
use Class.Div (Div, (/)) pub
use Class.Rem (Rem, (%)) pub
use Class.Functor (Functor, map) pub
use Class.Pure (Pure, pure) pub
use Class.Seq (Seq, seq, (<*>), (<*), (*>), seqLeft, seqRight) pub
use Class.Bind (Bind, bind, (>>=)) pub
use Class.Applicative (Applicative) pub
use Class.Monad (Monad) pub
use Class.Alternative (Alternative, failure, orElse, (<|>)) pub
use Class.Semigroup (Semigroup, append, (<>)) pub
use Class.Monoid (Monoid, empty) pub
use Class.Bifunctor (Bifunctor, bimap) pub
use Class.Foldable (Foldable, foldr, foldMap) pub
use Class.Traversable (Traversable, traverse, sequence) pub
use Data.Function (id, const, compose, flip, apply, pipe, (<<), (>>), (|>)) pub
use Data.Bool (not, (&&), (||), and, or) pub
use Data.Product (fst, snd, curry, uncurry, swap) pub
use Data.Ordering (Ordering(..)) pub
use Data.Maybe (Maybe(..), maybe, fromMaybe, isJust, isNothing) pub
use Data.Result (Result(..), result, mapError, toResult, toMaybe) pub
use Data.Const (Const(..), getConst) pub
use Data.Void (Void, absurd) pub
use Data.List (filter, foldl, length, reverse, concat, head, tail, last, take, drop, zip) pub
use Data.String (stringLength, stringAppend, stringToChars, charsToString, (++)) pub
use Data.Int (intToFloat, negate) pub
use Data.Float (floatToInt) pub
use System.IO (print, println, readLine) pub
