{-# NO_IMPLICIT_PRELUDE #-}
use Ficus.Builtin.Errors (..)
use Ficus.Builtin.IOMode (IOMode)

{-# BUILTIN HANDLE Handle #-}
Handle : Type

{-# BUILTIN HANDLE_STDIN stdin #-}
stdin : Handle
{-# BUILTIN HANDLE_STDOUT stdout #-}
stdout : Handle
{-# BUILTIN HANDLE_STDERR stderr #-}
stderr : Handle
{-# BUILTIN HANDLE_READ read #-}
read : Handle -> Int -> String
{-# BUILTIN HANDLE_WRITE write #-}
write : Handle -> String -> Unit

{-# BUILTIN HANDLE_OPEN_FILE openFile #-}
openFile : String -> IOMode -> Handle
{-# BUILTIN HANDLE_CLOSE close #-}
close : Handle -> Unit
