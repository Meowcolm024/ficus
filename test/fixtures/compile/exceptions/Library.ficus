{-# NO_IMPLICIT_PRELUDE #-} use Class.Show (Show, show)
use Control.Exception as Errors
use Class.Exception (Exception)
use Ficus.Builtin.Int (intAdd)

type Problem = Problem Int
impl Exception Problem = {}

check () = Errors.catch (_ -> Errors.throw (Problem 20)) ((Problem n) -> intAdd n 1)

impl Show Problem = { show (Problem n) = show n }
